# Bank Account Data user secrets — https://bankaccountdata.gocardless.com/ → Developers → User secrets
GOCARDLESS_SECRET_ID=
GOCARDLESS_SECRET_KEY=

# Where the bank sends the browser after the end user authorises access.
# Any URL you control; the account data itself is read through the API.
GOCARDLESS_REDIRECT_URI=https://bankaccountdata.gocardless.com/

# Optional. Defaults to https://bankaccountdata.gocardless.com/api/v2
# GOCARDLESS_BASE_URL=

# Optional. Where the access/refresh tokens are cached between runs.
# Defaults to $XDG_CACHE_HOME/gocardless-bank-account-data-mcp.
# GOCARDLESS_CACHE_DIR=
